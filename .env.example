# Server port (default: 5050)
PORT=5050

# OpenAI API key with Realtime API access
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Public HTTPS base URL for Twilio webhooks (required for local dev with ngrok)
# Example: https://abc123.ngrok-free.app
# Do NOT include a trailing slash.
PUBLIC_BASE_URL=

# Optional: voice pipeline tuning
# REALTIME_VAD_EAGERNESS=medium
# REALTIME_OUTPUT_SPEED=1.0
# REALTIME_VOICE=marin
# VOICE_LATENCY_LOG=true

# Optional: allow ?hotelId= override on /incoming-call (DEV/TEST ONLY).
# Never enable in production. Production routing is Phone Number → Hotel only.
# ALLOW_HOTEL_OVERRIDE=true
# NODE_ENV=development

# Optional: used only for launching outbound test calls via curl (not required by the app server)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
